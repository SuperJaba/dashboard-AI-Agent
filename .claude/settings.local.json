{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh repo *)",
      "Bash(gh config *)",
      "Bash(gh pr *)",
      "Bash(curl -s https://api.github.com/repos/SuperJaba/dashboard/pulls?state=all)",
      "Bash(git checkout *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "MCP_DOCKER"
  ],
  "disabledMcpjsonServers": [
    "MCP_DOCKER"
  ],
  "permissions": {
    "allow": [
      "Bash(npm run *)"
    ]
  }
}
