{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node --watch server.js",
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"node --watch server.js\" \"vite\"",
    "db:migrate": "node scripts/migrate.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/shared src/backend",
    "test:ui-components": "vitest run src/components src/hooks",
    "test:coverage": "vitest run --coverage",
    "test:sys": "node --test scripts/test-sys-admin.js",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "autotest": "bash scripts/autotest_ai.sh",
    "ci-tdd": "bash scripts/ci_tdd_bot.sh",
    "agent:worker": "node scripts/local-agent-worker.js",
    "agent.worker": "node scripts/local-agent-worker.js",
    "worker": "node scripts/local-agent-worker.js",
    "sync-tasks": "node src/backend/scripts/syncTasks.js",
    "test:e2e": "cross-env NODE_ENV=test node tests/full_test_suite.js",
    "deploy:ct8": "bash scripts/deploy-ct8-optimized.sh",
    "sync-remote-tasks": "node src/backend/scripts/syncRemoteTasks.js",
    "postinstall": "node -e \"try { const fs=require('fs'), path=require('path'); const d=path.join(path.dirname(require.resolve('node-pty/package.json')), 'prebuilds'); if(fs.existsSync(d)) fs.readdirSync(d).forEach(a => { const h=path.join(d, a, 'spawn-helper'); if(fs.existsSync(h)) fs.chmodSync(h, 0o755); }); } catch(e){}\"",
    "start": "node server.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "brotli": "^2.1.0",
    "compression": "^1.8.2",
    "concurrently": "^9.2.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "framer-motion": "^12.42.2",
    "fresh": "^2.0.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.63.0",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tldts": "^7.4.19",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-syntax-decorators": "^8.0.1",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/mocker": "^5.0.5",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.32",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "qs": "^6.17.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty": true,
    "fsevents@2.3.3": true
  },
  "description": "A full-stack, modern dashboard application built with React, TypeScript, Vite, and Express. This dashboard provides a comprehensive platform for monitoring servers, managing projects, executing AI agents, real-time terminal interactions, and LLM server management.",
  "main": "app.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperJaba/dashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SuperJaba/dashboard/issues"
  },
  "homepage": "https://github.com/SuperJaba/dashboard#readme"
}
