# ==========================================
# Dashboard Environment Variables Configuration
# ==========================================

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication Secret Key
JWT_SECRET=super-secret-jwt-key-change-in-production-12345

# AES-256 Encryption Key (32 characters / 256-bit key for securing sensitive data like SSH passwords)
ENCRYPTION_KEY=32_character_long_secret_encryption_key_123

# PostgreSQL Database Configuration (Docker PostgreSQL Container)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dashboard
DB_USER=SebaP
DB_PASSWORD=110112

# OpsRamp Monitoring & Remote Write Integration
OPSRAMP_ENABLED=false
OPSRAMP_ENDPOINT=https://<tenant-id>.app.opsramp.com/api/v1/metrics/prometheus/push
OPSRAMP_TOKEN=your_opsramp_api_token_here
OPSRAMP_INSTALL_AGENT=false

