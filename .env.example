# ==========================================
# Dashboard Environment Variables Configuration
# ==========================================

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication Secret Key
JWT_SECRET=super-secret-jwt-key-change-in-production-12345

# AES-256 Encryption Key (32 characters / 256-bit key for securing sensitive data like SSH passwords)
ENCRYPTION_KEY=32_character_long_secret_encryption_key_123

# PostgreSQL Database Configuration (Docker PostgreSQL Container)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dashboard
DB_USER=SebaP
DB_PASSWORD=110112

# OpsRamp Monitoring & AIOps Integration
OPSRAMP_ENABLED=true
OPSRAMP_MOCK_MODE=true
OPSRAMP_TENANT_ID=client_mock_corp_01
OPSRAMP_SERVER_URL=http://localhost:8085
OPSRAMP_ENDPOINT=http://localhost:8085/api/v1/metrics/prometheus/push
OPSRAMP_TOKEN=mock_opsramp_token_xyz123
OPSRAMP_INSTALL_AGENT=false

