# ==========================================
# Dashboard Environment Variables Configuration
# ==========================================

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication Secret Key
JWT_SECRET=super-secret-jwt-key-change-in-production-12345

# AES-256 Encryption Key (32 characters / 256-bit key for securing sensitive data like SSH passwords)
ENCRYPTION_KEY=32_character_long_secret_encryption_key_123

# PostgreSQL Database Configuration (Optional: In-Memory Fallback will be used if PostgreSQL is offline)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dashboard
DB_USER=postgres
DB_PASSWORD=postgres
